    ? 'ì €ì¥ëœ ë¹„ë°€ë²ˆí˜¸ê°€ ìˆìŠµë‹ˆë‹¤. ë³€ê²½í•  ë•Œë§Œ ìƒˆë¡œ ì…ë ¥í•˜ì„¸ìš”.'
    : 'ì•”í˜¸ê°€ ì—†ëŠ” ë„¤íŠ¸ì›Œí¬ëŠ” ë¹„ì›Œ ë‘ì„¸ìš”.';
  $('mqtt-password-help').textContent = config.mqtt_password_configured
    ? 'ì €ì¥ëœ ë¹„ë°€ë²ˆí˜¸ê°€ ìˆìŠµë‹ˆë‹¤. ë³€ê²½í•  ë•Œë§Œ ìƒˆë¡œ ì…ë ¥í•˜ì„¸ìš”.'
    : 'ë¸Œë¡œì»¤ì— ë¹„ë°€ë²ˆí˜¸ê°€ ì—†ìœ¼ë©´ ë¹„ì›Œ ë‘ì„¸ìš”.';
  $('mqtt-ca-help').textContent = config.mqtt_ca_configured
    ? 'ì €ì¥ëœ CA ì¸ì¦ì„œê°€ ìˆìŠµë‹ˆë‹¤. ë³€ê²½í•  ë•Œë§Œ ìƒˆë¡œ ì…ë ¥í•˜ì„¸ìš”.'
    : 'TLSë¥¼ ì¼œë©´ CA ì¸ì¦ì„œê°€ í•„ìš”í•©ë‹ˆë‹¤.';
  toggleTlsField();
}

async function loadStatus() {
  const status = await fetch('/api/status').then((response) => {
    if (!response.ok) throw new Error(response.statusText);
    return response.json();
  });
  applyStatus(status);
  return status;
}

function toggleTlsField() {
  $('mqtt-ca-field').hidden = !$('mqtt-tls').checked;
}

async function runButton(id, busyLabel, action) {
  setBusy(id, true, busyLabel);
  try {
    await action();
  } catch (error) {
    setMessage(error.message || 'ìš”ì²­ì„ ì²˜ë¦¬í•˜ì§€ ëª»í–ˆìŠµë‹ˆë‹¤.', 'error');
  } finally {
    setBusy(id, false, busyLabel);
  }
}

$('refresh-status').addEventListener('click', () => runButton('refresh-status', 'í™•ì¸ ì¤‘', async () => {
  await loadStatus();
  setMessage('í˜„ì¬ ì—°ê²° ìƒíƒœë¥¼ ìƒˆë¡œ í™•ì¸í–ˆìŠµë‹ˆë‹¤.', 'success');
}));

$('scan-wifi').addEventListener('click', () => runButton('scan-wifi', 'ê²€ìƒ‰ ì¤‘', async () => {
  const result = await fetch('/api/wifi/scan').then((response) => {
    if (!response.ok) throw new Error(response.statusText);
    return response.json();
  });
  const select = $('wifi-ssid');
  select.innerHTML = '';
  const aps = result.aps || [];
  if (aps.length === 0) {
    const option = document.createElement('option');
    option.value = '';
    option.textContent = 'ê²€ìƒ‰ëœ ë„¤íŠ¸ì›Œí¬ê°€ ì—†ìŠµë‹ˆë‹¤';
    select.appendChild(option);
    setMessage('Wi-Fië¥¼ ì°¾ì§€ ëª»í–ˆìŠµë‹ˆë‹¤. SSIDë¥¼ ì§ì ‘ ì…ë ¥í•  ìˆ˜ ìˆìŠµë‹ˆë‹¤.', 'error');
    return;
  }
  for (const ap of aps) {
    const option = document.createElement('option');
    option.value = ap.ssid;
    option.textContent = `${ap.ssid} Â· ${ap.rssi} dBm`;
    select.appendChild(option);
  }
  $('wifi-ssid-manual').value = '';
  setMessage(`${aps.length}ê°œì˜ Wi-Fië¥¼ ì°¾ì•˜ìŠµë‹ˆë‹¤.`, 'success');
}));

$('wifi-ssid').addEventListener('change', () => {
  if ($('wifi-ssid').value) $('wifi-ssid-manual').value = '';
});

$('wifi-ssid-manual').addEventListener('input', () => {
  if ($('wifi-ssid-manual').value.trim()) $('wifi-ssid').value = '';
});

$('mqtt-tls').addEventListener('change', toggleTlsField);

$('mqtt-config').addEventListener('submit', async (event) => {
  event.preventDefault();
  const ssid = $('wifi-ssid-manual').value.trim() || $('wifi-ssid').value;
  if (!ssid) {
    setMessage('ì—°ê²°í•  Wi-Fië¥¼ ê²€ìƒ‰í•˜ê±°ë‚˜ SSIDë¥¼ ì§ì ‘ ì…ë ¥í•˜ì„¸ìš”.', 'error');
    $('wifi-ssid').focus();
    return;
  }

  const payload = {
    wifi_ssid: ssid,
    wifi_password: $('wifi-password').value,
    mqtt_host: $('mqtt-host').value.trim(),
    mqtt_port: Number($('mqtt-port').value),
    mqtt_username: $('mqtt-username').value.trim(),
    mqtt_password: $('mqtt-password').value,
    mqtt_tls: $('mqtt-tls').checked,
    mqtt_ca: $('mqtt-ca').value.trim(),
    mqtt_client_id: $('mqtt-client-id').value.trim(),
    mqtt_base_topic: $('mqtt-base-topic').value.trim(),
  };

  await runButton('save-connect', 'ì €ì¥ ì¤‘', async () => {
    await api('/api/config', { method: 'POST', body: JSON.stringify(payload) });
    setMessage('ì„¤ì •ì„ ì €ì¥í–ˆìŠµë‹ˆë‹¤. ì„¤ì • APê°€ ì ì‹œ ì¢…ë£Œë©ë‹ˆë‹¤. ì—°ê²°ì— ì‹¤íŒ¨í•˜ë©´ ì„¤ì • APê°€ ìë™ìœ¼ë¡œ ë‹¤ì‹œ ë‚˜íƒ€ë‚©ë‹ˆë‹¤.', 'success');
    setTimeout(() => loadStatus().catch(() => {}), 1200);
  });
});

$('mqtt-test').addEventListener('click', () => runButton('mqtt-test', 'í…ŒìŠ¤íŠ¸ ì¤‘', async () => {
  await api('/api/mqtt/test', { method: 'POST', body: '{}' });
  setMessage('MQTT ì—°ê²° í…ŒìŠ¤íŠ¸ë¥¼ ì‹œì‘í–ˆìŠµë‹ˆë‹¤. ì ì‹œ í›„ ìƒíƒœë¥¼ ìƒˆë¡œê³ ì¹¨í•˜ì„¸ìš”.', 'success');
}));

$('replace-enrollment').addEventListener('click', () => {
  const confirmation = $('replace-confirmation').value;
  if (confirmation !== 'REPLACE ENROLLMENT') {
    setMessage('REPLACE ENROLLMENTë¥¼ ì •í™•íˆ ì…ë ¥í•˜ì„¸ìš”.', 'error');
    return;
  }
  runButton('replace-enrollment', 'êµì²´ ì¤‘', async () => {
    await api('/api/ble/replace', {
      method: 'POST',
      body: JSON.stringify({ confirmation }),
    });
    $('replace-confirmation').value = '';
    setMessage('ê¸°ì¡´ iPhone ë“±ë¡ì„ ì§€ìš°ê³  ìƒˆ ë“±ë¡ì„ ì‹œì‘í–ˆìŠµë‹ˆë‹¤.', 'success');
  });
});

$('restart').addEventListener('click', () => runButton('restart', 'ì¬ì‹œì‘ ìš”ì²­ ì¤‘', async () => {
  await api('/api/restart', { method: 'POST', body: '{}' });
  setMessage('ê¸°ê¸° ì¬ì‹œì‘ì„ ìš”ì²­í–ˆìŠµë‹ˆë‹¤.', 'success');
}));

$('reset-provisioning').addEventListener('click', () => {
  const confirmation = $('reset-confirmation').value;
  if (confirmation !== 'RESET PROVISIONING') {
    setMessage('RESET PROVISIONINGì„ ì •í™•íˆ ì…ë ¥í•˜ì„¸ìš”.', 'error');
    return;
  }
  runButton('reset-provisioning', 'ì´ˆê¸°í™” ì¤‘', async () => {
    await api('/api/reset', {
      method: 'POST',
      body: JSON.stringify({ confirmation }),
    });
    $('reset-confirmation').value = '';
    setMessage('Wi-Fiì™€ MQTT ì„¤ì •ì„ ì´ˆê¸°í™”í–ˆìŠµë‹ˆë‹¤.', 'success');
  });
});

loadStatus().catch((error) => setMessage(error.message || 'ê¸°ê¸° ìƒíƒœë¥¼ ë¶ˆëŸ¬ì˜¤ì§€ ëª»í–ˆìŠµë‹ˆë‹¤.', 'error'));

    updateTile('status-mqtt', 'ready', 'ì—°ê²°ë¨', config.mqtt_host || 'ë¸Œë¡œì»¤ ì¤€ë¹„ ì™„ë£Œ');
  } else if (runtime.sta_has_ip) {
    updateTile('status-mqtt', 'pending', 'ì—°ê²° ëŒ€ê¸°', config.mqtt_host || 'ë¸Œë¡œì»¤ ì£¼ì†Œë¥¼ ì…ë ¥í•˜ì„¸ìš”');
  } else {
    updateTile('status-mqtt', 'neutral', 'Wi-Fi í•„ìš”', 'Wi-Fi ì—°ê²° í›„ ë¸Œë¡œì»¤ì— ì ‘ì†í•©ë‹ˆë‹¤');
  }


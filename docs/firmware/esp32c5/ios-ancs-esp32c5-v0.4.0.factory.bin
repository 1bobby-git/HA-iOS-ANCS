    updateTile('status-ble', ready ? 'ready' : 'pending',
      ready ? 'ì•Œë¦¼ ìˆ˜ì‹  ì¤€ë¹„ ì™„ë£Œ' : 'ì—°ê²°ë¨ Â· ì¤€ë¹„ ì¤‘',
      ready ? 'ì¸ì¦ê³¼ ë‘ ANCS êµ¬ë… ì™„ë£Œ' : 'ì¸ì¦Â·ì„œë¹„ìŠ¤ ë°œê²¬Â·ì•Œë¦¼ êµ¬ë… ìƒíƒœë¥¼ í™•ì¸ ì¤‘');
    $('ble-guidance').textContent = ready
      ? 'ìƒˆ ì•Œë¦¼ì„ ë³´ë‚´ ì „ë‹¬ì„ í™•ì¸í•˜ì„¸ìš”. ë§ˆì§€ë§‰ ì•Œë¦¼ê³¼ í˜„ì¬ ì—°ê²° ìƒíƒœëŠ” ë³„ê°œì…ë‹ˆë‹¤.'
      : 'ì—°ê²°ë§Œìœ¼ë¡œ ì•Œë¦¼ ì¤€ë¹„ê°€ ì™„ë£Œë˜ì§€ëŠ” ì•ŠìŠµë‹ˆë‹¤. iPhoneì˜ ì‹œìŠ¤í…œ ì•Œë¦¼ ê³µìœ ë¥¼ í™•ì¸í•˜ì„¸ìš”.';
  } else if (system.ble_pairing_repair_required) {
    updateTile(
      'status-ble',
      'error',
      'ë“±ë¡ ë³µêµ¬ í•„ìš”',
      `ì¸ì¦ ì˜¤ë¥˜ ${Number(system.ble_auth_error || 0)} Â· PIN í™•ì¸ í›„ ë“±ë¡ì„ ë‹¤ì‹œ ìš”ì²­í•˜ì„¸ìš”`,
    );
    $('ble-guidance').textContent =

</html>
␀/␀␀:root {
  color-scheme: light;
  font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --color-page: #f4f6f8;
  --color-surface: #ffffff;
  --color-text: #172033;
  --color-muted: #647083;
  --color-border: #dce2e9;
  --color-border-strong: #c3ccd7;
  --color-primary: #1769e0;
  --color-primary-dark: #0f55bb;
  --color-primary-soft: #eaf2ff;
  --color-success: #14805e;
  --color-success-soft: #e7f7f1;
  --color-warning: #a86400;
  --color-warning-soft: #fff4dc;
  --color-danger: #b42318;
  --color-danger-soft: #fff0ee;
  --shadow-card: 0 12px 36px rgba(28, 39, 56, 0.07);
  background: var(--color-page);
  color: var(--color-text);
}

* {
  box-sizing: border-box;
}

body {
  min-width: 320px;
  margin: 0;
  background:
    radial-gradient(circle at 50% 0, rgba(23, 105, 224, 0.08), transparent 340px),
    var(--color-page);
}

button,
input,
select,
textarea {
  font: inherit;
}

button,
summary,
select {
  -webkit-tap-highlight-color: transparent;
}

.app-shell {
  width: 100%;
  max-width: 840px;
  margin: 0 auto;
  padding: 32px 20px 48px;
}

.hero {
  padding: 18px 4px 24px;
}

.eyebrow,
.section-kicker {
  margin: 0 0 6px;
  color: var(--color-primary);
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 0.09em;
  text-transform: uppercase;
}

h1,
h2,
h3,
p {
  margin-top: 0;
}

h1 {
  margin-bottom: 8px;
  font-size: clamp(1.85rem, 5vw, 2.55rem);
  line-height: 1.12;
  letter-spacing: -0.035em;
}

h2 {
  margin-bottom: 0;
  font-size: 1.25rem;
  line-height: 1.25;
  letter-spacing: -0.02em;
}

h3 {
  margin-bottom: 4px;
  font-size: 1rem;
  line-height: 1.35;
}

.hero-copy {
  margin-bottom: 18px;
  color: var(--color-muted);
  line-height: 1.55;
  word-break: keep-all;
}

.device-line {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-height: 32px;
  padding: 6px 12px;
  border: 1px solid var(--color-border);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.72);
  color: #3f4b5e;
  font-size: 0.82rem;
  font-weight: 700;
}

.device-mark,
.local-dot {
  width: 8px;
  height: 8px;
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--color-success);
  box-shadow: 0 0 0 4px var(--color-success-soft);
}

.message {
  display: none;
  margin: 14px 0 0;
  padding: 11px 13px;
  border: 1px solid var(--color-border);
  border-radius: 10px;
  background: var(--color-surface);
  color: var(--color-text);
  font-size: 0.9rem;
  line-height: 1.45;
}

.message:not(:empty) {
  display: block;
}

.message[data-tone="success"] {
  border-color: #a8ddca;
  background: var(--color-success-soft);
  color: #0d6248;
}

.message[data-tone="error"] {
  border-color: #f0b9b3;
  background: var(--color-danger-soft);
  color: var(--color-danger);
}

.panel {
  margin-bottom: 16px;
  padding: 22px;
  border: 1px solid var(--color-border);
  border-radius: 18px;
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 18px;
}

.step-badge,
.recommended,
.optional {
  display: inline-flex;
  align-items: center;
  border-radius: 999px;
  font-size: 0.72rem;
  font-weight: 750;
  white-space: nowrap;
}

.step-badge {
  min-height: 28px;
  padding: 5px 10px;
  background: var(--color-primary-soft);
  color: var(--color-primary-dark);
}

.recommended {
  padding: 3px 8px;
  background: var(--color-success-soft);
  color: var(--color-success);
}

.optional {
  margin-left: 4px;
  color: var(--color-muted);
  font-weight: 650;
}

.status-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}

.status-tile {
  display: grid;
  grid-template-columns: 10px minmax(0, 1fr);
  align-items: start;
  gap: 10px;
  min-height: 102px;
  padding: 14px;
  border: 1px solid var(--color-border);
  border-radius: 13px;
  background: #fbfcfd;
}

.status-dot {
  width: 9px;
  height: 9px;
  margin-top: 5px;
  border-radius: 50%;
  background: #8d98a8;
}

.status-label,
.status-tile strong,
.status-tile small {
  display: block;
}

.status-label {
  margin-bottom: 3px;
  color: var(--color-muted);
  font-size: 0.75rem;
  font-weight: 700;
}

.status-tile strong {
  margin-bottom: 4px;
  font-size: 0.98rem;
}

.status-tile small {
  color: var(--color-muted);
  font-size: 0.76rem;
  line-height: 1.35;
}

.status-tile[data-state="ready"] {
  border-color: #b9e2d3;
  background: var(--color-success-soft);
}

.status-tile[data-state="ready"] .status-dot {
  background: var(--color-success);
}

.status-tile[data-state="pending"] {
  border-color: #efd59f;
  background: var(--color-warning-soft);
}

.status-tile[data-state="pending"] .status-dot {
  background: var(--color-warning);
}

.status-tile[data-state="error"] {
  border-color: #f0b9b3;
  background: var(--color-danger-soft);
}

.status-tile[data-state="error"] .status-dot {
  background: var(--color-danger);
}

.status-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 16px;
  align-items: center;
  margin-top: 14px;
  padding-top: 14px;
  border-top: 1px solid var(--color-border);
}

.status-actions strong,
.status-actions small {
  display: block;
}

.status-actions strong {
  margin-bottom: 4px;
  font-size: 0.9rem;
}

.status-actions small {
  max-width: 560px;
  color: var(--color-muted);
  font-size: 0.76rem;
  line-height: 1.45;
}

.status-actions .button {
  min-width: 164px;
}

.setup-form {
  padding-bottom: 20px;
}

.form-section {
  padding: 22px 0;
  border-top: 1px solid var(--color-border);
}

.form-section:first-of-type {
  padding-top: 4px;
  border-top: 0;
}

.form-section-heading {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  margin-bottom: 18px;
}

.form-section-heading p,
.ble-copy p,
.management-item p {
  margin-bottom: 0;
  color: var(--color-muted);
  font-size: 0.86rem;
  line-height: 1.5;
  word-break: keep-all;
}

.step-number {
  display: grid;
  width: 28px;
  height: 28px;
  flex: 0 0 auto;
  place-items: center;
  border-radius: 9px;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: 0.82rem;
  font-weight: 850;
}

.field,
.field-grid,
.scan-row {
  min-width: 0;
}

.field + .field,
.field-grid + .field-grid,
.field-grid + .field,
.field + .field-grid {
  margin-top: 16px;
}

.field-grid {
  display: grid;
  gap: 16px;
}

.scan-row {
  display: grid;
  gap: 10px;
  margin-bottom: 16px;
}

label {
  display: inline-block;
  margin-bottom: 7px;
  color: #303b4c;
  font-size: 0.87rem;
  font-weight: 750;
}

.label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.label-row label {
  margin-bottom: 7px;
}

input,
select,
textarea {
  width: 100%;
  min-height: 46px;
  border: 1px solid var(--color-border-strong);
  border-radius: 11px;
  outline: none;
  background: #ffffff;
  color: var(--color-text);
  padding: 10px 12px;
  font-size: 1rem;
  line-height: 1.35;
  transition: border-color 140ms ease, box-shadow 140ms ease;
}

input::placeholder,
textarea::placeholder {
  color: #98a2b1;
}

textarea {
  min-height: 132px;
  resize: vertical;
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  font-size: 0.78rem;
}

.machine-value {
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  font-size: 0.86rem;
}

.field small {
  display: block;
  margin-top: 6px;
  color: var(--color-muted);
  font-size: 0.76rem;
  line-height: 1.4;
}

.button {
  min-height: 46px;
  border: 1px solid transparent;
  border-radius: 11px;
  padding: 10px 15px;
  cursor: pointer;
  font-weight: 780;
  line-height: 1.2;
  transition: background 140ms ease, border-color 140ms ease, transform 140ms ease;
}

.button:hover:not(:disabled) {
  transform: translateY(-1px);
}

.button:disabled {
  cursor: wait;
  color: #758094;
  background: #e8ecf1;
}

.button-primary {
  background: var(--color-primary);
  color: #ffffff;
}

.button-primary:hover:not(:disabled) {
  background: var(--color-primary-dark);
}

.button-secondary {
  border-color: var(--color-border-strong);
  background: #ffffff;
  color: #344054;
}

.button-secondary:hover:not(:disabled),
.button-quiet:hover:not(:disabled) {
  background: #f1f4f7;
}

.button-quiet {
  border-color: transparent;
  background: transparent;
  color: var(--color-primary);
}

.button-compact {
  min-height: 38px;
  padding: 8px 11px;
  font-size: 0.8rem;
}

.button-danger {
  border-color: #efb2ac;
  background: #ffffff;
  color: var(--color-danger);
}

.button-danger:hover:not(:disabled) {
  background: var(--color-danger-soft);
}

input:focus-visible,
select:focus-visible,
textarea:focus-visible,
button:focus-visible,
summary:focus-visible {
  outline: 3px solid rgba(23, 105, 224, 0.22);
  outline-offset: 2px;
  border-color: var(--color-primary);
}

.disclosure {
  margin-top: 18px;
  border: 1px solid var(--color-border);
  border-radius: 13px;
  background: #fafbfd;
  overflow: hidden;
}

.disclosure > summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  min-height: 58px;
  padding: 13px 15px;
  cursor: pointer;
  list-style: none;
}

.disclosure > summary::-webkit-details-marker {
  display: none;
}

.disclosure > summary strong,
.disclosure > summary small {
  display: block;
}

.disclosure > summary strong {
  margin-bottom: 2px;
  font-size: 0.9rem;
}

.disclosure > summary small {
  color: var(--color-muted);
  font-size: 0.74rem;
}

.summary-chevron {
  width: 9px;
  height: 9px;
  flex: 0 0 auto;
  border-right: 2px solid #657084;
  border-bottom: 2px solid #657084;
  transform: rotate(45deg);
  transition: transform 150ms ease;
}

.disclosure[open] .summary-chevron {
  transform: rotate(225deg);
}

.disclosure-body {
  padding: 16px;
  border-top: 1px solid var(--color-border);
  background: #ffffff;
}

.check-row {
  display: grid;
  grid-template-columns: 22px minmax(0, 1fr);
  gap: 10px;
  align-items: start;
  margin: 18px 0 0;
  padding: 13px;
  border: 1px solid var(--color-border);
  border-radius: 11px;
  cursor: pointer;
}

.check-row input {
  width: 20px;
  min-height: 20px;
  margin: 1px 0 0;
  accent-color: var(--color-primary);
}

.check-row strong,
.check-row small {
  display: block;
}

.check-row strong {
  margin-bottom: 3px;
  font-size: 0.86rem;
}

.check-row small {
  color: var(--color-muted);
  font-size: 0.76rem;
  font-weight: 500;
}

#mqtt-ca-field {
  margin-top: 14px;
}

.form-note {
  display: grid;
  grid-template-columns: 22px minmax(0, 1fr);
  gap: 9px;
  align-items: start;
  margin: 2px 0 18px;
  padding: 12px 13px;
  border-radius: 11px;
  background: var(--color-primary-soft);
  color: #29466e;
}

.form-note > span {
  display: grid;
  width: 20px;
  height: 20px;
  place-items: center;
  border-radius: 50%;
  background: var(--color-primary);
  color: #ffffff;
  font-size: 0.72rem;
  font-weight: 850;
}

.form-note p {
  margin: 0;
  font-size: 0.78rem;
  line-height: 1.45;
}

.form-actions {
  display: grid;
  gap: 10px;
}

.ble-panel {
  display: grid;
  gap: 18px;
}

.ble-copy h2 {
  margin-bottom: 8px;
}

.ble-enroll-actions {
  display: grid;
  gap: 10px;
  min-width: min(100%, 220px);
}

.ble-enroll-code {
  padding: 12px 14px;
  border: 1px solid #b9e2d3;
  border-radius: 12px;
  background: var(--color-success-soft);
  text-align: center;
}

.ble-enroll-code span,
.ble-enroll-code strong,
.ble-enroll-code small {
  display: block;
}

.ble-enroll-code span {
  color: var(--color-success);
  font-size: 0.72rem;
  font-weight: 800;
}

.ble-enroll-code strong {
  margin: 4px 0;
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  font-size: 1.45rem;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.12em;
}

.ble-enroll-code small {
  color: var(--color-muted);
  font-size: 0.72rem;
  line-height: 1.35;
}

.management {
  padding: 0;
}

.management > summary {
  padding: 18px 22px;
}

.management-body {
  padding: 0 22px 22px;
  border-top: 0;
}

.management-item {
  display: grid;
  gap: 12px;
  padding: 18px 0;
  border-top: 1px solid var(--color-border);
}

.management-item:first-child {
  border-top: 0;
}

.management-item label {
  margin-bottom: -5px;
}

.management-item code {
  padding: 2px 5px;
  border-radius: 5px;
  background: #f0f2f5;
  color: #384456;
  font-size: 0.74rem;
}

.danger-zone {
  color: var(--color-danger);
}

.danger-zone p,
.danger-zone label {
  color: #8e3a33;
}

footer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  padding: 12px 4px 0;
  color: var(--color-muted);
  font-size: 0.76rem;
  text-align: center;
}

footer .local-dot {
  width: 6px;
  height: 6px;
  box-shadow: none;
}

[hidden] {
  display: none !important;
}

@media (min-width: 680px) {
  .app-shell {
    padding-top: 46px;
  }

  .field-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .host-grid {
    grid-template-columns: minmax(0, 3fr) minmax(120px, 1fr);
  }

  .scan-row {
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
  }

  .scan-button {
    min-width: 132px;
  }

  .form-actions {
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
  }

  .ble-panel {
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
  }

  .ble-panel .button {
    min-width: 170px;
  }

  .management-item {
    grid-template-columns: minmax(0, 1fr) minmax(180px, 0.65fr);
    align-items: end;
  }

  .management-item > label,
  .management-item > input {
    grid-column: 1 / -1;
  }

  .management-item > button {
    grid-column: 2;
  }
}

@media (min-width: 760px) {
  .status-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
}

@media (max-width: 480px) {
  .app-shell {
    padding: 20px 12px 36px;
  }

  .panel {
    padding: 18px;
    border-radius: 15px;
  }

  .status-panel {
    padding: 16px;
  }

  .status-grid {
    grid-template-columns: 1fr;
  }

  .status-tile {
    min-height: 82px;
  }

  .management {
    padding: 0;
  }

  .management > summary {
    padding: 17px 18px;
  }

  .management-body {
    padding: 0 18px 18px;
  }

  .section-heading {
    align-items: flex-start;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    transition: none !important;
  }
}
.8␀␀const $ = (id) => document.getElementById(id);
const STATUS_POLL_MS = 2000;
let formHydrated = false;

function setMessage(text, tone = 'info') {
  const message = $('message');
  message.textContent = text;
  message.dataset.tone = tone;
}

function setBusy(id, busy, busyLabel) {
  const button = $(id);
  if (!button.dataset.label) button.dataset.label = button.textContent;
  button.dataset.busy = busy ? 'true' : 'false';
  const requiresMqtt = button.dataset.requiresMqtt === 'true';
  const mqttConnected = document.body?.dataset?.mqttConnected === 'true';
  button.disabled = busy || (requiresMqtt && !mqttConnected);
  button.textContent = busy ? busyLabel : button.dataset.label;
}

// Server error keys that need a Korean explanation instead of the raw key.
const API_ERROR_MESSAGES = {
  mqtt_password_required:
    'ì—°ê²°ëœ ì ì´ ìˆëŠ” MQTT ì„œë²„ì˜ ì£¼ì†Œë‚˜ í¬íŠ¸ë¥¼ ë°”ê¾¸ë©´ ì €ì¥ëœ ë¹„ë°€ë²ˆí˜¸ë¥¼ ìƒˆ ì„œë²„ë¡œ ë³´ë‚´ì§€ ì•ŠìŠµë‹ˆë‹¤. MQTT ë¹„ë°€ë²ˆí˜¸ë¥¼ ë‹¤ì‹œ ì…ë ¥í•˜ì„¸ìš”.',
};

async function api(path, options = {}) {
  const response = await fetch(path, {
    headers: { 'content-type': 'application/json' },
    cache: 'no-store',
    ...options,
  });
  const body = await response.json().catch(() => ({}));
  if (!response.ok) {
    throw new Error(API_ERROR_MESSAGES[body.error] || body.error || response.statusText);
  }
  return body;
}

const delay = (milliseconds) =>
  new Promise((resolve) => setTimeout(resolve, milliseconds));

function deviceSuffix(apSsid) {
  const match = String(apSsid || '').match(/([0-9a-f]{4})$/i);
  return match ? match[1].toLowerCase() : 'c6';
}

function iphoneBluetoothName(apSsid, deviceFamily) {
  return `IOS-ANCS-${deviceFamily}-${deviceSuffix(apSsid).toUpperCase()}`;
}

function recommendedClientId(apSsid, deviceFamily) {
  return `ios_ancs_${deviceFamily.toLowerCase()}_${deviceSuffix(apSsid)}`;
}

function recommendedBaseTopic(apSsid, deviceFamily) {
  return `ios-ancs/${deviceFamily.toLowerCase()}-${deviceSuffix(apSsid)}`;
}

function updateTile(id, state, value, detail) {
  $(id).dataset.state = state;
  $(`${id}-value`).textContent = value;
  $(`${id}-detail`).textContent = detail;
}

function updateEnrollmentControls(system, blePasskey) {
  const button = $('start-enrollment');
  const code = $('ble-enroll-code');
  const codeValue = $('ble-enroll-code-value');
  const busy = button.dataset.busy === 'true';
  const windowOpen = Boolean(system.enroll_window_open);
  code.hidden = !windowOpen;
  codeValue.textContent = blePasskey || 'í™•ì¸ ì¤‘';

  let label = 'iPhone ê¸°ê¸° ë“±ë¡';
  let unavailable = false;
  if (system.ble_connected) {
    label = 'iPhone ì—°ê²°ë¨';
    unavailable = true;
  } else if (system.ble_pairing_repair_required) {
    label = 'PIN í™•ì¸ í›„ ë“±ë¡ ì¬ì‹œë„';
  } else if (windowOpen) {
    label = 'ë“±ë¡ ì‹ í˜¸ ë‹¤ì‹œ ë³´ë‚´ê¸°';
  } else if (system.ble_bonded) {
    label = 'ë“±ë¡ëœ iPhone ë‹¤ì‹œ ì—°ê²°';
  }
  if (!busy) {
    button.textContent = label;
    button.dataset.label = label;
  }
  button.disabled = busy || unavailable;
}

function mqttEndpoint(config) {
  const host = config.mqtt_host || 'ë¸Œë¡œì»¤ ì£¼ì†Œ ë¯¸ì„¤ì •';
  const port = Number(config.mqtt_port || 1883);
  return `${host}:${port} Â· ${config.mqtt_tls ? 'TLS' : 'TCP'}`;
}

function mqttErrorDetail(system, config) {
  const endpoint = mqttEndpoint(config);
  const type = Number(system.mqtt_error_type || 0);
  const espError = Number(system.mqtt_last_esp_error || 0);
  const socketError = Number(system.mqtt_last_socket_errno || 0);
  const returnCode = Number(system.mqtt_connect_return_code || 0);
  const retrySeconds = Math.max(
    0,
    Math.round(Number(system.mqtt_retry_delay_ms || 0) / 1000),
  );
  const retry = retrySeconds > 0 ? ` Â· ${retrySeconds}ì´ˆ í›„ ì¬ì‹œë„` : '';

  if (type === 2) {
    if (returnCode === 4 || returnCode === 5) {
      return `${endpoint} Â· ì‚¬ìš©ì ì´ë¦„ ë˜ëŠ” ë¹„ë°€ë²ˆí˜¸ê°€ ê±°ë¶€ë¨${retry}`;
    }
    if (returnCode === 2) {
      return `${endpoint} Â· Client IDê°€ ê±°ë¶€ë¨${retry}`;
    }
    if (returnCode === 3) {
      return `${endpoint} Â· ë¸Œë¡œì»¤ ì‚¬ìš© ë¶ˆê°€${retry}`;
    }
    return `${endpoint} Â· ë¸Œë¡œì»¤ ì—°ê²° ê±°ë¶€ ì½”ë“œ ${returnCode}${retry}`;
  }

  if (type === 1 || espError || socketError) {
    if (espError === 32774 || socketError === 110) {
      return `${endpoint} Â· TCP ì—°ê²° ì‹œê°„ ì´ˆê³¼${retry}`;
    }
    if (socketError === 111 || socketError === 61) {
      return `${endpoint} Â· í¬íŠ¸ ì—°ê²° ê±°ë¶€${retry}`;
    }
    if (socketError === 101 || socketError === 113) {
      return `${endpoint} Â· ESP32 ë„¤íŠ¸ì›Œí¬ì—ì„œ ì„œë²„ê¹Œì§€ ê²½ë¡œ ì—†ìŒ${retry}`;
    }
    return `${endpoint} Â· ì „ì†¡ ì˜¤ë¥˜ ESP ${espError}, socket ${socketError}${retry}`;
  }

  return `${endpoint}${retry}`;
}

function relayDropBreakdown(system = {}) {
  const detailKeys = [
    'notifications_dropped_offline',
    'notifications_dropped_enqueue',
    'notifications_dropped_policy',
  ];
  const hasDetailedCounters = detailKeys.some((key) =>
    Object.prototype.hasOwnProperty.call(system, key),
  );
  const offline = Number(system.notifications_dropped_offline || 0);
  const enqueue = Number(system.notifications_dropped_enqueue || 0);
  const policy = Number(system.notifications_dropped_policy || 0);
  const calculatedTotal = offline + enqueue + policy;
  const total = Number(system.notifications_dropped ?? calculatedTotal);
  if (total <= 0) {
    return { total: 0, offline, enqueue, policy, detail: null };
  }
  if (!hasDetailedCounters) {
    return {
      total,
      offline,
      enqueue,
      policy,
      detail: `ë¶€íŒ… í›„ ì œì™¸ ${total}ê±´ Â· ì´ì „ íŒì›¨ì–´ëŠ” ì œì™¸ ì›ì¸ì„ êµ¬ë¶„í•˜ì§€ ì•ŠìŠµë‹ˆë‹¤`,
    };
  }
  const reasons = [];
  if (offline > 0) reasons.push(`MQTT ë¯¸ì—°ê²° ${offline}ê±´`);
  if (policy > 0) reasons.push(`ì •ì±… í•„í„° ${policy}ê±´`);
  if (enqueue > 0) reasons.push(`ë‚´ë¶€ ì²˜ë¦¬ ì‹¤íŒ¨ ${enqueue}ê±´`);
  const unclassified = Math.max(0, total - calculatedTotal);
  if (unclassified > 0) reasons.push(`ê¸°íƒ€ ${unclassified}ê±´`);
  return {
    total,
    offline,
    enqueue,
    policy,
    detail: `ë¶€íŒ… í›„ ì œì™¸ ${total}ê±´${reasons.length ? ` Â· ${reasons.join(' Â· ')}` : ''}`,
  };
}

function hydrateForm(status, apName, deviceFamily) {
  if (formHydrated) return;
  const config = status.config || {};
  $('wifi-ssid-manual').value = config.wifi_ssid || '';
  $('mqtt-host').value = config.mqtt_host || '';
  $('mqtt-port').value = config.mqtt_port || 1883;
  $('mqtt-username').value = config.mqtt_username || '';
  $('mqtt-tls').checked = Boolean(config.mqtt_tls);
  $('mqtt-client-id').value =
    config.mqtt_client_id || recommendedClientId(apName, deviceFamily);
  $('mqtt-base-topic').value =
    config.mqtt_base_topic || recommendedBaseTopic(apName, deviceFamily);
  formHydrated = true;
}

function applyStatus(status) {
  const runtime = status.runtime || {};
  const system = status.system || {};
  const config = status.config || {};
  const target = String(status.target || 'esp32c6').toLowerCase();
  const deviceFamily = String(status.device_family || 'C6').toUpperCase();
  const apName = runtime.ap_ssid || 'IOS-ANCS-SETUP';
  const bluetoothName = iphoneBluetoothName(apName, deviceFamily);
  const passkeyValue = Number(system.ble_passkey || 0);
  const blePasskey = Number.isInteger(passkeyValue) &&
    passkeyValue >= 100000 && passkeyValue <= 999999
    ? String(passkeyValue).padStart(6, '0')
    : null;

  if (document.body?.dataset) {
    document.body.dataset.target = target;
    document.body.dataset.mqttConnected =
      system.mqtt_connected ? 'true' : 'false';
  }

  $('device-name').textContent = apName;

  if (runtime.sta_has_ip) {
    updateTile('status-wifi', 'ready', 'ì—°ê²°ë¨', config.wifi_ssid || 'IP ì£¼ì†Œë¥¼ ë°›ì•˜ìŠµë‹ˆë‹¤');
  } else if (runtime.sta_connecting) {
    updateTile('status-wifi', 'pending', 'ì—°ê²° ì¤‘', config.wifi_ssid || 'Wi-Fi ì‘ë‹µì„ ê¸°ë‹¤ë¦¬ëŠ” ì¤‘');
  } else if (runtime.sta_started && !runtime.retry_paused) {
    const seconds = Math.ceil(Number(runtime.retry_in_ms || 0) / 1000);
    updateTile('status-wifi', 'pending', 'ìë™ ë³µêµ¬ ëŒ€ê¸°',
      `${seconds}ì´ˆ í›„ ì¬ì‹œë„ Â· ë‹¨ì ˆ ì›ì¸ ${Number(runtime.last_wifi_disconnect_reason || 0)}`);
  } else {
    updateTile('status-wifi', 'pending', 'ì„¤ì • í•„ìš”', runtime.ap_started ? 'ì•„ë˜ì—ì„œ Wi-Fië¥¼ ì„ íƒí•˜ì„¸ìš”' : 'Wi-Fi ì—°ê²° ì—†ìŒ');
  }

  if (system.mqtt_connected) {
    updateTile('status-mqtt', 'ready', 'ì—°ê²°ë¨', mqttEndpoint(config));
  } else if (system.mqtt_connecting) {
    updateTile('status-mqtt', 'pending', 'ì—°ê²° ì¤‘', mqttEndpoint(config));
  } else if (runtime.sta_has_ip && Number(system.mqtt_last_error_at_ms || 0) > 0) {
    updateTile('status-mqtt', 'error', 'ì—°ê²° ì‹¤íŒ¨', mqttErrorDetail(system, config));
  } else if (runtime.sta_has_ip) {
    updateTile('status-mqtt', 'pending', 'ì—°ê²° ëŒ€ê¸°', mqttErrorDetail(system, config));
  } else {
    updateTile('status-mqtt', 'neutral', 'Wi-Fi í•„ìš”', 'Wi-Fi ì—°ê²° í›„ ë¸Œë¡œì»¤ì— ì ‘ì†í•©ë‹ˆë‹¤');
  }

  if (system.ble_connected) {

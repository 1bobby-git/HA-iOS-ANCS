Á+␀␀:root {
  color-scheme: light;
  font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --color-page: #f4f6f8;
  --color-surface: #ffffff;
  --color-text: #172033;
  --color-muted: #647083;
  --color-border: #dce2e9;
  --color-border-strong: #c3ccd7;
  --color-primary: #1769e0;
  --color-primary-dark: #0f55bb;
  --color-primary-soft: #eaf2ff;
  --color-success: #14805e;
  --color-success-soft: #e7f7f1;
  --color-warning: #a86400;
  --color-warning-soft: #fff4dc;
  --color-danger: #b42318;
  --color-danger-soft: #fff0ee;
  --shadow-card: 0 12px 36px rgba(28, 39, 56, 0.07);
  background: var(--color-page);
  color: var(--color-text);
}

* {
  box-sizing: border-box;
}

body {
  min-width: 320px;
  margin: 0;
  background:
    radial-gradient(circle at 50% 0, rgba(23, 105, 224, 0.08), transparent 340px),
    var(--color-page);
}

button,
input,
select,
textarea {
  font: inherit;
}

button,
summary,
select {
  -webkit-tap-highlight-color: transparent;
}

.app-shell {
  width: 100%;
  max-width: 840px;
  margin: 0 auto;
  padding: 32px 20px 48px;
}

.hero {
  padding: 18px 4px 24px;
}

.eyebrow,
.section-kicker {
  margin: 0 0 6px;
  color: var(--color-primary);
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 0.09em;
  text-transform: uppercase;
}

h1,
h2,
h3,
p {
  margin-top: 0;
}

h1 {
  margin-bottom: 8px;
  font-size: clamp(1.85rem, 5vw, 2.55rem);
  line-height: 1.12;
  letter-spacing: -0.035em;
}

h2 {
  margin-bottom: 0;
  font-size: 1.25rem;
  line-height: 1.25;
  letter-spacing: -0.02em;
}

h3 {
  margin-bottom: 4px;
  font-size: 1rem;
  line-height: 1.35;
}

.hero-copy {
  margin-bottom: 18px;
  color: var(--color-muted);
  line-height: 1.55;
  word-break: keep-all;
}

.device-line {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-height: 32px;
  padding: 6px 12px;
  border: 1px solid var(--color-border);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.72);
  color: #3f4b5e;
  font-size: 0.82rem;
  font-weight: 700;
}

.device-mark,
.local-dot {
  width: 8px;
  height: 8px;
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--color-success);
  box-shadow: 0 0 0 4px var(--color-success-soft);
}

.message {
  display: none;
  margin: 14px 0 0;
  padding: 11px 13px;
  border: 1px solid var(--color-border);
  border-radius: 10px;
  background: var(--color-surface);
  color: var(--color-text);
  font-size: 0.9rem;
  line-height: 1.45;
}

.message:not(:empty) {
  display: block;
}

.message[data-tone="success"] {
  border-color: #a8ddca;
  background: var(--color-success-soft);
  color: #0d6248;
}

.message[data-tone="error"] {
  border-color: #f0b9b3;
  background: var(--color-danger-soft);
  color: var(--color-danger);
}

.panel {
  margin-bottom: 16px;
  padding: 22px;
  border: 1px solid var(--color-border);
  border-radius: 18px;
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 18px;
}

.step-badge,
.recommended,
.optional {
  display: inline-flex;
  align-items: center;
  border-radius: 999px;
  font-size: 0.72rem;
  font-weight: 750;
  white-space: nowrap;
}

.step-badge {
  min-height: 28px;
  padding: 5px 10px;
  background: var(--color-primary-soft);
  color: var(--color-primary-dark);
}

.recommended {
  padding: 3px 8px;
  background: var(--color-success-soft);
  color: var(--color-success);
}

.optional {
  margin-left: 4px;
  color: var(--color-muted);
  font-weight: 650;
}

.status-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}

.status-tile {
  display: grid;
  grid-template-columns: 10px minmax(0, 1fr);
  align-items: start;
  gap: 10px;
  min-height: 102px;
  padding: 14px;
  border: 1px solid var(--color-border);
  border-radius: 13px;
  background: #fbfcfd;
}

.status-dot {
  width: 9px;
  height: 9px;
  margin-top: 5px;
  border-radius: 50%;
  background: #8d98a8;
}

.status-label,
.status-tile strong,
.status-tile small {
  display: block;
}

.status-label {
  margin-bottom: 3px;
  color: var(--color-muted);
  font-size: 0.75rem;
  font-weight: 700;
}

.status-tile strong {
  margin-bottom: 4px;
  font-size: 0.98rem;
}

.status-tile small {
  color: var(--color-muted);
  font-size: 0.76rem;
  line-height: 1.35;
}

.status-tile[data-state="ready"] {
  border-color: #b9e2d3;
  background: var(--color-success-soft);
}

.status-tile[data-state="ready"] .status-dot {
  background: var(--color-success);
}

.status-tile[data-state="pending"] {
  border-color: #efd59f;
  background: var(--color-warning-soft);
}

.status-tile[data-state="pending"] .status-dot {
  background: var(--color-warning);
}

.status-tile[data-state="error"] {
  border-color: #f0b9b3;
  background: var(--color-danger-soft);
}

.status-tile[data-state="error"] .status-dot {
  background: var(--color-danger);
}

.setup-form {
  padding-bottom: 20px;
}

.form-section {
  padding: 22px 0;
  border-top: 1px solid var(--color-border);
}

.form-section:first-of-type {
  padding-top: 4px;
  border-top: 0;
}

.form-section-heading {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  margin-bottom: 18px;
}

.form-section-heading p,
.ble-copy p,
.management-item p {
  margin-bottom: 0;
  color: var(--color-muted);
  font-size: 0.86rem;
  line-height: 1.5;
  word-break: keep-all;
}

.step-number {
  display: grid;
  width: 28px;
  height: 28px;
  flex: 0 0 auto;
  place-items: center;
  border-radius: 9px;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: 0.82rem;
  font-weight: 850;
}

.field,
.field-grid,
.scan-row {
  min-width: 0;
}

.field + .field,
.field-grid + .field-grid,
.field-grid + .field,
.field + .field-grid {
  margin-top: 16px;
}

.field-grid {
  display: grid;
  gap: 16px;
}

.scan-row {
  display: grid;
  gap: 10px;
  margin-bottom: 16px;
}

label {
  display: inline-block;
  margin-bottom: 7px;
  color: #303b4c;
  font-size: 0.87rem;
  font-weight: 750;
}

.label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.label-row label {
  margin-bottom: 7px;
}

input,
select,
textarea {
  width: 100%;
  min-height: 46px;
  border: 1px solid var(--color-border-strong);
  border-radius: 11px;
  outline: none;
  background: #ffffff;
  color: var(--color-text);
  padding: 10px 12px;
  font-size: 1rem;
  line-height: 1.35;
  transition: border-color 140ms ease, box-shadow 140ms ease;
}

input::placeholder,
textarea::placeholder {
  color: #98a2b1;
}

textarea {
  min-height: 132px;
  resize: vertical;
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  font-size: 0.78rem;
}

.machine-value {
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  font-size: 0.86rem;
}

.field small {
  display: block;
  margin-top: 6px;
  color: var(--color-muted);
  font-size: 0.76rem;
  line-height: 1.4;
}

.button {
  min-height: 46px;
  border: 1px solid transparent;
  border-radius: 11px;
  padding: 10px 15px;
  cursor: pointer;
  font-weight: 780;
  line-height: 1.2;
  transition: background 140ms ease, border-color 140ms ease, transform 140ms ease;
}

.button:hover:not(:disabled) {
  transform: translateY(-1px);
}

.button:disabled {
  cursor: wait;
  color: #758094;
  background: #e8ecf1;
}

.button-primary {
  background: var(--color-primary);
  color: #ffffff;
}

.button-primary:hover:not(:disabled) {
  background: var(--color-primary-dark);
}

.button-secondary {
  border-color: var(--color-border-strong);
  background: #ffffff;
  color: #344054;
}

.button-secondary:hover:not(:disabled),
.button-quiet:hover:not(:disabled) {
  background: #f1f4f7;
}

.button-quiet {
  border-color: transparent;
  background: transparent;
  color: var(--color-primary);
}

.button-compact {
  min-height: 38px;
  padding: 8px 11px;
  font-size: 0.8rem;
}

.button-danger {
  border-color: #efb2ac;
  background: #ffffff;
  color: var(--color-danger);
}

.button-danger:hover:not(:disabled) {
  background: var(--color-danger-soft);
}

input:focus-visible,
select:focus-visible,
textarea:focus-visible,
button:focus-visible,
summary:focus-visible {
  outline: 3px solid rgba(23, 105, 224, 0.22);
  outline-offset: 2px;
  border-color: var(--color-primary);
}

.disclosure {
  margin-top: 18px;
  border: 1px solid var(--color-border);
  border-radius: 13px;
  background: #fafbfd;
  overflow: hidden;
}

.disclosure > summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  min-height: 58px;
  padding: 13px 15px;
  cursor: pointer;
  list-style: none;
}

.disclosure > summary::-webkit-details-marker {
  display: none;
}

.disclosure > summary strong,
.disclosure > summary small {
  display: block;
}

.disclosure > summary strong {
  margin-bottom: 2px;
  font-size: 0.9rem;
}

.disclosure > summary small {
  color: var(--color-muted);
  font-size: 0.74rem;
}

.summary-chevron {
  width: 9px;
  height: 9px;
  flex: 0 0 auto;
  border-right: 2px solid #657084;
  border-bottom: 2px solid #657084;
  transform: rotate(45deg);
  transition: transform 150ms ease;
}

.disclosure[open] .summary-chevron {
  transform: rotate(225deg);
}

.disclosure-body {
  padding: 16px;
  border-top: 1px solid var(--color-border);
  background: #ffffff;
}

.check-row {
  display: grid;
  grid-template-columns: 22px minmax(0, 1fr);
  gap: 10px;
  align-items: start;
  margin: 18px 0 0;
  padding: 13px;
  border: 1px solid var(--color-border);
  border-radius: 11px;
  cursor: pointer;
}

.check-row input {
  width: 20px;
  min-height: 20px;
  margin: 1px 0 0;
  accent-color: var(--color-primary);
}

.check-row strong,
.check-row small {
  display: block;
}

.check-row strong {
  margin-bottom: 3px;
  font-size: 0.86rem;
}

.check-row small {
  color: var(--color-muted);
  font-size: 0.76rem;
  font-weight: 500;
}

#mqtt-ca-field {
  margin-top: 14px;
}

.form-note {
  display: grid;
  grid-template-columns: 22px minmax(0, 1fr);
  gap: 9px;
  align-items: start;
  margin: 2px 0 18px;
  padding: 12px 13px;
  border-radius: 11px;
  background: var(--color-primary-soft);
  color: #29466e;
}

.form-note > span {
  display: grid;
  width: 20px;
  height: 20px;
  place-items: center;
  border-radius: 50%;
  background: var(--color-primary);
  color: #ffffff;
  font-size: 0.72rem;
  font-weight: 850;
}

.form-note p {
  margin: 0;
  font-size: 0.78rem;
  line-height: 1.45;
}

.form-actions {
  display: grid;
  gap: 10px;
}

.ble-panel {
  display: grid;
  gap: 18px;
}

.ble-copy h2 {
  margin-bottom: 8px;
}

.management {
  padding: 0;
}

.management > summary {
  padding: 18px 22px;
}

.management-body {
  padding: 0 22px 22px;
  border-top: 0;
}

.management-item {
  display: grid;
  gap: 12px;
  padding: 18px 0;
  border-top: 1px solid var(--color-border);
}

.management-item:first-child {
  border-top: 0;
}

.management-item label {
  margin-bottom: -5px;
}

.management-item code {
  padding: 2px 5px;
  border-radius: 5px;
  background: #f0f2f5;
  color: #384456;
  font-size: 0.74rem;
}

.danger-zone {
  color: var(--color-danger);
}

.danger-zone p,
.danger-zone label {
  color: #8e3a33;
}

footer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  padding: 12px 4px 0;
  color: var(--color-muted);
  font-size: 0.76rem;
  text-align: center;
}

footer .local-dot {
  width: 6px;
  height: 6px;
  box-shadow: none;
}

[hidden] {
  display: none !important;
}

@media (min-width: 680px) {
  .app-shell {
    padding-top: 46px;
  }

  .field-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .host-grid {
    grid-template-columns: minmax(0, 3fr) minmax(120px, 1fr);
  }

  .scan-row {
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
  }

  .scan-button {
    min-width: 132px;
  }

  .form-actions {
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
  }

  .ble-panel {
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
  }

  .ble-panel .button {
    min-width: 170px;
  }

  .management-item {
    grid-template-columns: minmax(0, 1fr) minmax(180px, 0.65fr);
    align-items: end;
  }

  .management-item > label,
  .management-item > input {
    grid-column: 1 / -1;
  }

  .management-item > button {
    grid-column: 2;
  }
}

@media (min-width: 760px) {
  .status-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
}

@media (max-width: 480px) {
  .app-shell {
    padding: 20px 12px 36px;
  }

  .panel {
    padding: 18px;
    border-radius: 15px;
  }

  .status-panel {
    padding: 16px;
  }

  .status-grid {
    grid-template-columns: 1fr;
  }

  .status-tile {
    min-height: 82px;
  }

  .management {
    padding: 0;
  }

  .management > summary {
    padding: 17px 18px;
  }

  .management-body {
    padding: 0 18px 18px;
  }

  .section-heading {
    align-items: flex-start;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    transition: none !important;
  }
}
K3␀␀const $ = (id) => document.getElementById(id);

function setMessage(text, tone = 'info') {
  const message = $('message');
  message.textContent = text;
  message.dataset.tone = tone;
}

function setBusy(id, busy, busyLabel) {
  const button = $(id);
  if (!button.dataset.label) button.dataset.label = button.textContent;
  button.disabled = busy;
  button.textContent = busy ? busyLabel : button.dataset.label;
}

async function api(path, options = {}) {
  const response = await fetch(path, {
    headers: { 'content-type': 'application/json' },
    ...options,
  });
  const body = await response.json().catch(() => ({}));
  if (!response.ok) throw new Error(body.error || response.statusText);
  return body;
}

function deviceSuffix(apSsid) {
  const match = String(apSsid || '').match(/([0-9a-f]{4})$/i);
  return match ? match[1].toLowerCase() : 'c6';
}

function iphoneBluetoothName(apSsid, deviceFamily) {
  return `IOS-ANCS-${deviceFamily}-${deviceSuffix(apSsid).toUpperCase()}`;
}

function recommendedClientId(apSsid, deviceFamily) {
  return `ios_ancs_${deviceFamily.toLowerCase()}_${deviceSuffix(apSsid)}`;
}

function recommendedBaseTopic(apSsid, deviceFamily) {
  return `ios-ancs/${deviceFamily.toLowerCase()}-${deviceSuffix(apSsid)}`;
}

function updateTile(id, state, value, detail) {
  $(id).dataset.state = state;
  $(`${id}-value`).textContent = value;
  $(`${id}-detail`).textContent = detail;
}


      : `ë“±ë¡ ì‹ í˜¸ë¥¼ ë³´ë‚´ê³  ìˆìŠµë‹ˆë‹¤. iPhone Bluetooth ì„¤ì •ì—ì„œ ${bluetoothName}ì„ ì„ íƒí•˜ê³  ì„¤ì • í¬í„¸ì— í‘œì‹œëœ 6ìë¦¬ ì½”ë“œë¥¼ ì…ë ¥í•˜ì„¸ìš”.`;
  } else if (system.ble_bonded) {
    updateTile('status-ble', 'pending', 'ë“±ë¡ë¨ Â· ì—°ê²° ëŒ€ê¸°', 'ë“±ë¡ëœ iPhoneì„ ì°¾ê³  ìˆìŠµë‹ˆë‹¤');
    $('ble-guidance').textContent = 'ë“±ë¡ëœ iPhoneë§Œ ìë™ìœ¼ë¡œ ë‹¤ì‹œ ì—°ê²°ë©ë‹ˆë‹¤. ì´ í˜ì´ì§€ì˜ ë²„íŠ¼ìœ¼ë¡œ ì¬ì—°ê²° ì‹ í˜¸ë¥¼ ë‹¤ì‹œ ë³´ë‚¼ ìˆ˜ ìˆìŠµë‹ˆë‹¤.';
  } else {
    updateTile('status-ble', 'neutral', 'ë¯¸ë“±ë¡ Â· ê´‘ê³  êº¼ì§', 'ë“±ë¡ ì‹œì‘ ì „ì—ëŠ” Bluetooth ë“±ë¡ ì‹ í˜¸ë¥¼ ë³´ë‚´ì§€ ì•ŠìŠµë‹ˆë‹¤');
    $('ble-guidance').textContent = 'ì´ í˜ì´ì§€ì˜ iPhone ê¸°ê¸° ë“±ë¡ ë²„íŠ¼ì„ ëˆ„ë¥´ë©´ Bluetooth ë“±ë¡ ì‹ í˜¸ë¥¼ ë³´ëƒ…ë‹ˆë‹¤.';
  }

  updateEnrollmentControls(system, blePasskey);

  const published = Number(system.notifications_published || 0);
  const dropStats = relayDropBreakdown(system);
  const relayReady = runtime.sta_has_ip && system.mqtt_connected && system.ble_connected;
  const relayState = relayReady
    ? 'ready'
    : system.mqtt_connected || system.mqtt_connecting
      ? 'pending'
      : runtime.sta_has_ip
        ? 'error'
        : 'neutral';
  updateTile(
    'status-relay',
    relayState,
    `${published}ê±´ ì „ì†¡`,
    dropStats.detail
      || (system.mqtt_connected
        ? 'í…ŒìŠ¤íŠ¸ ì•Œë¦¼ ë˜ëŠ” iPhone ì•Œë¦¼ì„ ê¸°ë‹¤ë¦¬ê³  ìˆìŠµë‹ˆë‹¤'
        : 'MQTT ì—°ê²°ì´ ì¤€ë¹„ë˜ë©´ Discoveryê°€ ìë™ ë°œí–‰ë©ë‹ˆë‹¤'),
  );

  const testButton = $('test-notification');
  testButton.dataset.requiresMqtt = 'true';
  if (testButton.dataset.busy !== 'true') {
    testButton.disabled = !system.mqtt_connected;
  }

  hydrateForm(status, apName, deviceFamily);

  $('wifi-password-help').textContent = config.wifi_password_configured
    ? 'ì €ì¥ëœ ë¹„ë°€ë²ˆí˜¸ê°€ ìˆìŠµë‹ˆë‹¤. ë³€ê²½í•  ë•Œë§Œ ìƒˆë¡œ ì…ë ¥í•˜ì„¸ìš”.'
    : 'ì•”í˜¸ê°€ ì—†ëŠ” ë„¤íŠ¸ì›Œí¬ëŠ” ë¹„ì›Œ ë‘ì„¸ìš”.';
  $('mqtt-password-help').textContent = config.mqtt_password_configured
    ? 'ì €ì¥ëœ ë¹„ë°€ë²ˆí˜¸ê°€ ìˆìŠµë‹ˆë‹¤. ë³€ê²½í•  ë•Œë§Œ ìƒˆë¡œ ì…ë ¥í•˜ì„¸ìš”.'
    : 'ë¸Œë¡œì»¤ì— ë¹„ë°€ë²ˆí˜¸ê°€ ì—†ìœ¼ë©´ ë¹„ì›Œ ë‘ì„¸ìš”.';
  $('mqtt-ca-help').textContent = config.mqtt_ca_configured
    ? 'ì €ì¥ëœ CA ì¸ì¦ì„œê°€ ìˆìŠµë‹ˆë‹¤. ë³€ê²½í•  ë•Œë§Œ ìƒˆë¡œ ì…ë ¥í•˜ì„¸ìš”.'
    : 'TLSë¥¼ ì¼œë©´ CA ì¸ì¦ì„œê°€ í•„ìš”í•©ë‹ˆë‹¤.';

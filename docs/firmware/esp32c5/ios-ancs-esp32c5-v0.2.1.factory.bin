    updateTile('status-wifi', 'ready', 'ì—°ê²°ë¨', config.wifi_ssid || 'IP ì£¼ì†Œë¥¼ ë°›ì•˜ìŠµë‹ˆë‹¤');
  } else if (runtime.sta_connecting) {
    updateTile('status-wifi', 'pending', 'ì—°ê²° ì¤‘', config.wifi_ssid || 'Wi-Fi ì‘ë‹µì„ ê¸°ë‹¤ë¦¬ëŠ” ì¤‘');
  } else {
    updateTile('status-wifi', 'pending', 'ì„¤ì • í•„ìš”', runtime.ap_started ? 'ì•„ë˜ì—ì„œ Wi-Fië¥¼ ì„ íƒí•˜ì„¸ìš”' : 'Wi-Fi ì—°ê²° ì—†ìŒ');
  }

  if (system.mqtt_connected) {
    updateTile('status-mqtt', 'ready', 'ì—°ê²°ë¨', config.mqtt_host || 'ë¸Œë¡œì»¤ ì¤€ë¹„ ì™„ë£Œ');
  } else if (runtime.sta_has_ip) {
    updateTile('status-mqtt', 'pending', 'ì—°ê²° ëŒ€ê¸°', config.mqtt_host || 'ë¸Œë¡œì»¤ ì£¼ì†Œë¥¼ ì…ë ¥í•˜ì„¸ìš”');
  } else {
    updateTile('status-mqtt', 'neutral', 'Wi-Fi í•„ìš”', 'Wi-Fi ì—°ê²° í›„ ë¸Œë¡œì»¤ì— ì ‘ì†í•©ë‹ˆë‹¤');
  }

  if (system.ble_connected) {
    updateTile('status-ble', 'ready', 'ì—°ê²°ë¨', 'iPhone ì•Œë¦¼ ê³µìœ  ì¤€ë¹„ ì™„ë£Œ');
    $('ble-guidance').textContent = 'ë“±ë¡ëœ iPhoneì´ ì—°ê²°ë˜ì–´ ìˆìŠµë‹ˆë‹¤. ì „ì›ì„ ë‹¤ì‹œ ì¼œë„ ìë™ìœ¼ë¡œ ì¬ì—°ê²°ë©ë‹ˆë‹¤.';
  } else if (system.enroll_window_open) {
    updateTile('status-ble', 'pending', 'ë“±ë¡ ëŒ€ê¸°', `${bluetoothName}ì„ iPhone Bluetooth ì„¤ì •ì—ì„œ ì„ íƒí•˜ì„¸ìš”`);
    $('ble-guidance').textContent = `ë“±ë¡ ì‹ í˜¸ë¥¼ ë³´ë‚´ê³  ìˆìŠµë‹ˆë‹¤. iPhone Bluetooth ì„¤ì •ì—ì„œ ${bluetoothName}ì„ ì„ íƒí•˜ê³ , í‘œì‹œë˜ë©´ ì½”ë“œ 123456ì„ ì…ë ¥í•˜ì„¸ìš”.`;
  } else if (system.ble_bonded) {
    updateTile('status-ble', 'pending', 'ë“±ë¡ë¨ Â· ì—°ê²° ëŒ€ê¸°', 'ë“±ë¡ëœ iPhoneì„ ì°¾ê³  ìˆìŠµë‹ˆë‹¤');
    $('ble-guidance').textContent = 'ë“±ë¡ëœ iPhoneë§Œ ìë™ìœ¼ë¡œ ë‹¤ì‹œ ì—°ê²°ë©ë‹ˆë‹¤. ë²„íŠ¼ì„ ëˆ„ë¥´ë©´ ê¸°ì¡´ iPhone ì—°ê²° ì‹ í˜¸ë¥¼ ì¦‰ì‹œ ë³´ëƒ…ë‹ˆë‹¤.';
  } else {
    updateTile('status-ble', 'neutral', 'ë¯¸ë“±ë¡ Â· ê´‘ê³  êº¼ì§', 'ë“±ë¡ ì‹œì‘ ì „ì—ëŠ” Bluetooth ë“±ë¡ ì‹ í˜¸ë¥¼ ë³´ë‚´ì§€ ì•ŠìŠµë‹ˆë‹¤');
    $('ble-guidance').textContent = 'iPhone ë“±ë¡ ì‹œì‘ì„ ëˆ„ë¥´ë©´ Bluetooth ë“±ë¡ ì‹ í˜¸ë¥¼ ë³´ëƒ…ë‹ˆë‹¤. ì´í›„ì—ëŠ” ë“±ë¡ëœ iPhoneë§Œ ìë™ìœ¼ë¡œ ë‹¤ì‹œ ì—°ê²°ë©ë‹ˆë‹¤.';

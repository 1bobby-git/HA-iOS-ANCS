  });
});

$('restart').addEventListener('click', () => runButton('restart', 'ì¬ì‹œì‘ ìš”ì²­ ì¤‘', async () => {
  await api('/api/restart', { method: 'POST', body: '{}' });
  setMessage('ê¸°ê¸° ì¬ì‹œì‘ì„ ìš”ì²­í–ˆìŠµë‹ˆë‹¤.', 'success');
}));

$('reset-provisioning').addEventListener('click', () => {
  const confirmation = $('reset-confirmation').value;
  if (confirmation !== 'RESET PROVISIONING') {
    setMessage('RESET PROVISIONINGì„ ì •í™•íˆ ì…ë ¥í•˜ì„¸ìš”.', 'error');
    return;
  }
  runButton('reset-provisioning', 'ì´ˆê¸°í™” ì¤‘', async () => {

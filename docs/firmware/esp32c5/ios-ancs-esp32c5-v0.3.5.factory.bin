      'ë“±ë¡ ë³µêµ¬ í•„ìš”',
      `ì¸ì¦ ì˜¤ë¥˜ ${Number(system.ble_auth_error || 0)} Â· iPhoneì˜ ê¸°ì¡´ Bluetooth ë“±ë¡ì„ ì§€ìš°ì„¸ìš”`,
    );
    $('ble-guidance').textContent =
      'ë°˜ë³µ ì¸ì¦ ì‹¤íŒ¨ë¡œ ìë™ ì¬ì—°ê²°ì„ ì¤‘ì§€í–ˆìŠµë‹ˆë‹¤. iPhone ì„¤ì • > Bluetoothì—ì„œ ê¸°ì¡´ IOS-ANCS í•­ëª©ì„ ì§€ìš´ ë’¤, ì•„ë˜ì˜ iPhone ë“±ë¡ êµì²´ë¥¼ ì‹¤í–‰í•˜ì„¸ìš”.';
  } else if (system.enroll_window_open) {
    updateTile(
      'status-ble',
      'pending',
      'ë“±ë¡ ëŒ€ê¸°',
      blePasskey
        ? `${bluetoothName} Â· ë“±ë¡ ì½”ë“œ ${blePasskey}`
        : `${bluetoothName}ì„ iPhone Bluetooth ì„¤ì •ì—ì„œ ì„ íƒí•˜ì„¸ìš”`,
    );
    $('ble-guidance').textContent = blePasskey
      ? `ë“±ë¡ ì‹ í˜¸ë¥¼ ë³´ë‚´ê³  ìˆìŠµë‹ˆë‹¤. iPhone Bluetooth ì„¤ì •ì—ì„œ ${bluetoothName}ì„ ì„ íƒí•˜ê³  ì¥ì¹˜ë³„ ì½”ë“œ ${blePasskey}ë¥¼ ì…ë ¥í•˜ì„¸ìš”.`
      : `ë“±ë¡ ì‹ í˜¸ë¥¼ ë³´ë‚´ê³  ìˆìŠµë‹ˆë‹¤. iPhone Bluetooth ì„¤ì •ì—ì„œ ${bluetoothName}ì„ ì„ íƒí•˜ê³  ì„¤ì • í¬í„¸ì— í‘œì‹œëœ 6ìë¦¬ ì½”ë“œë¥¼ ì…ë ¥í•˜ì„¸ìš”.`;
  } else if (system.ble_bonded) {
    updateTile('status-ble', 'pending', 'ë“±ë¡ë¨ Â· ì—°ê²° ëŒ€ê¸°', 'ë“±ë¡ëœ iPhoneì„ ì°¾ê³  ìˆìŠµë‹ˆë‹¤');
    $('ble-guidance').textContent = 'ë“±ë¡ëœ iPhoneë§Œ ìë™ìœ¼ë¡œ ë‹¤ì‹œ ì—°ê²°ë©ë‹ˆë‹¤. Home Assistant ë²„íŠ¼ ë˜ëŠ” BOOT 3ì´ˆ ê¸¸ê²Œ ëˆ„ë¥´ê¸°ë¡œ ì¬ì—°ê²° ì‹ í˜¸ë¥¼ ë³´ë‚¼ ìˆ˜ ìˆìŠµë‹ˆë‹¤.';
  } else {
    updateTile('status-ble', 'neutral', 'ë¯¸ë“±ë¡ Â· ê´‘ê³  êº¼ì§', 'ë“±ë¡ ì‹œì‘ ì „ì—ëŠ” Bluetooth ë“±ë¡ ì‹ í˜¸ë¥¼ ë³´ë‚´ì§€ ì•ŠìŠµë‹ˆë‹¤');
    $('ble-guidance').textContent = 'Home Assistantì˜ iPhone ë“±ë¡ ì‹œì‘ ë²„íŠ¼ì„ ëˆ„ë¥´ê±°ë‚˜ BOOT ë²„íŠ¼ì„ 3ì´ˆ ë™ì•ˆ ëˆ„ë¥´ë©´ Bluetooth ë“±ë¡ ì‹ í˜¸ë¥¼ ë³´ëƒ…ë‹ˆë‹¤.';
  }

  const published = Number(system.notifications_published || 0);
  const dropped = Number(system.notifications_dropped || 0);
  const relayReady = runtime.sta_has_ip && system.mqtt_connected && system.ble_connected;
  updateTile(
    'status-relay',
    relayReady ? 'ready' : system.mqtt_connected ? 'pending' : 'neutral',
    `${published}ê±´ ì „ì†¡`,
    dropped > 0
      ? `ì—°ê²° ì¥ì•  ì¤‘ ${dropped}ê±´ ì œì™¸`
      : system.mqtt_connected

  });
});

loadStatus().catch((error) => setMessage(error.message || 'ê¸°ê¸° ìƒíƒœë¥¼ ë¶ˆëŸ¬ì˜¤ì§€ ëª»í–ˆìŠµë‹ˆë‹¤.', 'error'));


    assert "STATUS_POLL_MS = 2000" in script


def test_repeated_ble_auth_failure_stops_the_reconnect_loop():
    client = read("components/ancs_client/ancs_client.c")
    header = read("components/ancs_client/include/ancs_client.h")
    script = read("components/portal_http/portal.js")

    assert "AUTH_FAILURE_REPAIR_THRESHOLD 3U" in client
    assert "AUTH_FAILURE_WINDOW_MS 120000LL" in client
    assert "pairing_repair_required" in client
    assert "pairing_repair_required" in header
    assert "pairing repair required" in client
    assert "if (repair_required)" in client
    assert "schedule_advertising_retry();" in client
    repair = client.split("if (repair_required)", 1)[1].split("} else {", 1)[0]
    assert "stop_advertising();" in repair
    assert "schedule_advertising_retry" not in repair
    assert "ble_pairing_repair_required" in script
    assert "등록 복구 필요" in script


def test_portal_reclaims_stale_http_connections():
    source = read("components/portal_http/portal_http.c")

    assert "config.max_open_sockets = 7" in source
    assert "config.lru_purge_enable = true" in source
    assert "config.recv_wait_timeout = 5" in source
    assert "config.send_wait_timeout = 5" in source
    assert '"/favicon.ico"' in source


def test_device_specific_passkey_and_ap_hardening_are_enabled():
    credentials = read("components/device_credentials/device_credentials.c")
    client = read("components/ancs_client/ancs_client.c")
    runtime = read("components/provisioning/provisioning_runtime.c")

    assert "esp_fill_random" in credentials
    assert "nvs_set_u32" in credentials
    assert "device_credentials_ble_passkey()" in client
    assert "123456" not in client
    assert "#define PROVISIONING_AP_MAX_CLIENTS 1" in runtime
    assert "ap_config->ap.pmf_cfg.capable = true" in runtime
''',
)

for path in (
    "README.md",
    "docs/IOS_PAIRING.md",
    "docs/TROUBLESHOOTING.md",
):
    text = read(path).replace(
        "123456",
        "설정 포털에 등록 시간 동안 표시되는 장치별 6자리 코드",
    )
    write(path, text)

write(
    "README.en.md",
    read("README.en.md").replace(
        "123456",
        "the device-specific six-digit code shown in the setup portal while enrollment is open",
    ),
)

readme = read("README.md")
feature_note = '''
### 설정 포털 자체 진단

펌웨어 0.3.5부터 MQTT 연결 직후 Home Assistant Discovery가 먼저 발행되므로 실제 iPhone 알림이 없어도 기기가 등록됩니다. 설정 포털의 **테스트 알림 보내기**는 ESP32 → MQTT → Home Assistant 전체 경로를 확인하며, 브로커 연결 실패 시 TCP 시간 초과·포트 거부·인증 거부와 재시도 간격을 표시합니다.
'''
if "### 설정 포털 자체 진단" not in readme:
    marker = "\n## "
    position = readme.find(marker)
    if position < 0:
        readme += "\n" + feature_note
    else:
        readme = readme[:position] + "\n" + feature_note + readme[position:]
    write("README.md", readme)

troubleshooting = read("docs/TROUBLESHOOTING.md")
diagnostic_note = '''
## MQTT 브로커 연결 대기에서 멈춤

설정 포털은 2초마다 연결 상태를 갱신합니다. `연결 실패`가 표시되면 브로커 주소·포트·TLS 모드와 함께 TCP 시간 초과, 포트 거부, 인증 거부 또는 ESP32 네트워크 경로 오류가 표시됩니다. PC에서 포트가 열리더라도 ESP32가 연결된 서브넷의 NAT loopback·VLAN·게스트 네트워크 정책은 별도로 확인해야 합니다.

MQTT가 연결되면 Home Assistant Discovery가 실제 iPhone 알림보다 먼저 발행됩니다. **테스트 알림 보내기**로 BLE 연결 없이도 MQTT 센서 등록과 상태 갱신을 검증할 수 있습니다.
'''
if "## MQTT 브로커 연결 대기에서 멈춤" not in troubleshooting:
    troubleshooting += "\n" + diagnostic_note
    write("docs/TROUBLESHOOTING.md", troubleshooting)

# Firmware version references only. Keep Home Assistant integration at 0.6.7.
for path in ROOT.rglob("*"):
    if not path.is_file() or ".git" in path.parts:
        continue
    try:
        text = path.read_text(encoding="utf-8")
    except UnicodeDecodeError:
        continue
    if OLD_FIRMWARE in text:
        path.write_text(
            text.replace(OLD_FIRMWARE, NEW_FIRMWARE),
            encoding="utf-8",
        )

manifest = json.loads(
    read("custom_components/ha_ios_ancs/manifest.json")
)
manifest["version"] = "0.6.7"
write(
    "custom_components/ha_ios_ancs/manifest.json",
    json.dumps(manifest, ensure_ascii=False, indent=2) + "\n",
)

changelog = ROOT / "CHANGELOG.md"
existing = changelog.read_text(encoding="utf-8") if changelog.exists() else "# 변경 이력\n"
heading = "## 펌웨어 0.3.5 - 2026-09-01"
if heading not in existing:
    body = f'''# 변경 이력

{heading}

- 설정 포털에서 BLE 연결 없이 ESP32 → MQTT → Home Assistant 테스트 알림을 전송할 수 있습니다.
- MQTT 연결 직후 현재 Discovery를 우선 발행하고, 엔티티별 4초 대기를 제거해 최초 기기 등록 시간을 수분에서 수초 수준으로 줄였습니다.
- MQTT 상태를 2초마다 자동 갱신하고 TCP 시간 초과·포트 거부·인증 거부·재시도 간격을 표시합니다.
- MQTT 재연결을 5초 → 15초 → 30초 → 60초로 제한하고 중복 연결 시도를 차단했습니다.
- 반복 BLE 인증 실패 3회 시 무한 재연결을 중지하고 iPhone 등록 복구 절차를 안내합니다.
- 고정 PIN을 장치별 무작위 6자리 코드로 교체하고 설정 AP를 1명 접속 및 선택적 PMF로 강화했습니다.
- HTTP LRU 정리와 소켓 제한을 적용해 복구 포털의 파일 디스크립터 고갈을 방지합니다.

'''
    if existing.startswith("# 변경 이력"):
        existing = existing.split("\n", 1)[1].lstrip("\n")
    changelog.write_text(body + existing, encoding="utf-8")

# Safety contracts.
assert "123456" not in read("components/ancs_client/ancs_client.c")
assert "MQTT_RELAY_DISCOVERY_SETTLE_MS" not in read(
    "components/mqtt_relay/mqtt_relay.c"
)
assert '"version": "0.6.7"' in read(
    "custom_components/ha_ios_ancs/manifest.json"
)


legacy_block = '''    for (size_t field_index = 0;
         field_index < mqtt_relay_legacy_discovery_count();
         ++field_index) {
        if (mqtt_relay_build_legacy_discovery_topic(discovery_config,
                                                    field_index,
                                                    discovery_topic,
                                                    sizeof(discovery_topic)) != ESP_OK ||
            !mqtt_relay_publish_discovery_once(discovery_topic, "")) {
            goto cleanup;
        }
    }

'''
mqtt_source = read("components/mqtt_relay/mqtt_relay.c")
if legacy_block not in mqtt_source:
    raise SystemExit("legacy discovery cleanup block not found")
mqtt_source = mqtt_source.replace(legacy_block, "", 1)
old_mark = '''    mqtt_relay_lock();
    s_ctx.discovery_attempted_this_boot = true;
    mqtt_relay_unlock();
cleanup:
'''

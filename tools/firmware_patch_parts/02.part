    for (size_t field_index = 0;
         field_index < mqtt_relay_legacy_discovery_count();
         ++field_index) {
        if (mqtt_relay_build_legacy_discovery_topic(discovery_config,
                                                    field_index,
                                                    discovery_topic,
                                                    sizeof(discovery_topic)) != ESP_OK ||
            !mqtt_relay_publish_discovery_once(discovery_topic, "")) {
            break;
        }
    }
cleanup:
'''
if old_mark not in mqtt_source:
    raise SystemExit("discovery completion marker not found")
write(
    "components/mqtt_relay/mqtt_relay.c",
    mqtt_source.replace(old_mark, new_mark, 1),
)

